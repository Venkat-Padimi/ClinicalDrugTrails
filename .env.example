# Clinical Trial Site Selection & Recruitment Agent
# Optional environment configurations (the app runs 100% locally with synthetic data without any API keys)

# Application Environment
ENV=development
LOG_LEVEL=INFO

# Streamlit Port Configuration (Default: 8501)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false

# Optional LLM API Key (if extending with external providers; fallback deterministic engines are active by default)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
